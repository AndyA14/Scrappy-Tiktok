# Configuración del Servidor
HOST=127.0.0.1
PORT=8000

# Clave de API de Google Gemini (Opcional pero altamente recomendada)
# Puedes obtener una clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_aqui_AIzaSy...

# Modelo de Gemini para análisis psicológico y de video
GEMINI_MODEL=gemini-2.0-flash

# Opciones de Scraper
DEFAULT_MAX_VIDEOS=10
HEADLESS_MODE=false
PAGE_TIMEOUT_MS=45000
